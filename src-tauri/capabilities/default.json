{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Uygulama penceresi ve masaüstü widget penceresi (panel pencereleri hariç: uzak sayfaya IPC verilmez)",
  "windows": [
    "main",
    "widget"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-show-main",
    "allow-open-panel",
    "allow-close-panel",
    "allow-set-locked",
    "allow-set-shell-visible",
    "allow-system-idle-seconds",
    "allow-toggle-widget",
    "allow-toggle-window-fullscreen",
    "allow-set-tray-tooltip",
    "allow-quit-app",
    "notification:default",
    "os:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://*.local"
        },
        {
          "url": "http://*.local:*"
        },
        {
          "url": "http://*.test"
        },
        {
          "url": "http://*.test:*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        }
      ]
    }
  ]
}
